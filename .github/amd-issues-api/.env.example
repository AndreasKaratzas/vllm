# AMD Issues API Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: API Authentication Token
# =============================================================================
# Generate with: openssl rand -hex 32
# Must be at least 32 characters
AMD_API_TOKEN=your_secure_token_here_min_32_characters

# =============================================================================
# Model Configuration
# =============================================================================
# Options:
#   - Qwen/Qwen2.5-7B-Instruct (default, good balance)
#   - Qwen/Qwen2.5-3B-Instruct (faster, less accurate)
#   - meta-llama/Llama-3.1-8B-Instruct (alternative)
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# =============================================================================
# Rate Limiting
# =============================================================================
# Requests per minute per token
RATE_LIMIT_RPM=100

# =============================================================================
# Vector Database (Qdrant)
# =============================================================================
# Default assumes Qdrant running in Docker Compose
QDRANT_URL=http://qdrant:6333

# =============================================================================
# Optional: External LLM Provider
# =============================================================================
# If using external Ollama or vLLM instance
# OLLAMA_URL=http://localhost:11434
# VLLM_URL=http://localhost:8080
