ARG BASE_IMAGE=ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401
# Constant per lineage so rebuilds of unchanged steps produce identical layer
# digests (with the exporter's rewrite-timestamp=true). Never derive it from
# the build time.
ARG SOURCE_DATE_EPOCH=1791494299
ARG PYTHON_VERSION=3.12
ARG PIP_VERSION=25.2
ARG TORCH_VERSION=2.12.0+rocm10.0.0
ARG TORCHVISION_VERSION=0.27.0+rocm10.0.0
ARG TORCHAUDIO_VERSION=2.11.0+rocm10.0.0
# release/internal/3.8.x as of 09/29/2026
ARG TRITON_BRANCH="669b31ac"
ARG TRITON_VERSION=3.8.0+git669b31ac
ARG TRITON_REPO="https://github.com/ROCm/triton.git"
ARG FA_BRANCH="0e60e394"
ARG FA_REPO="https://github.com/Dao-AILab/flash-attention.git"
ARG AITER_BRANCH="v0.1.24.post1"
ARG AITER_REPO="https://github.com/ROCm/aiter.git"
ARG MORI_BRANCH="v1.2.3.post1"
ARG MORI_REPO="https://github.com/ROCm/mori.git"
ARG ROCM_SYSTEMS_REPO="https://github.com/ROCm/rocm-systems.git"
ARG ROCM_RUNTIME_COMMIT="25e14349f2606a6b95c4ccd45eb92a1835646cf2"
ARG TORCHCODEC_REPO="https://github.com/pytorch/torchcodec.git"
ARG TORCHCODEC_BRANCH="v0.10.0"
ARG UV_VERSION=0.13.0
# NIC backend for MoRI RDMA support.
# By default (all), drivers and userspace libraries for all supported NIC types
# (ainic and bnxt) are installed; MoRI selects the appropriate one at runtime.
# To install drivers for a single NIC type only, set NIC_BACKEND explicitly:
#   --build-arg NIC_BACKEND=ainic   # AMD AINIC (Pensando) only
#   --build-arg NIC_BACKEND=bnxt    # Broadcom Thor-2 only
#   --build-arg NIC_BACKEND=none    # Install nothing.
ARG NIC_BACKEND=all
# AMD AINIC apt repo settings
# Users can specify a custom version compatible with their host drivers.
# The default version has been tested with ionic-dkms=26.03.3.001
# (libionic1=54.0-187-1), required for MoRI-EP/NIXL on Pollara/AINIC.
ARG AINIC_VERSION=1.117.5-a-77
ARG UBUNTU_CODENAME=jammy


# TheRock configuration
ARG SITE_PACKAGES=/usr/local/lib/python${PYTHON_VERSION}/dist-packages
# Pre-built GPU images, packages, etc.
ARG ROCM_RELEASE_WHEELS_MULTIARCH_URL="https://stable.repo.amd.com/rocm/whl-next/"
# torch, triton, etc. wheels with latest fixes.
ARG ROCM_NIGHTLY_WHEELS_MULTIARCH_URL="https://nightly.repo.amd.com/rocm/whl-next/"
ARG ROCM_SDK_VERSION=10.0.0

# Build configuration
ARG PYTORCH_ROCM_ARCH="gfx90a;gfx942;gfx950;gfx1100;gfx1101;gfx1200;gfx1201;gfx1150;gfx1151"
ARG AITER_ROCM_ARCH="gfx942;gfx950"

# Sccache configuration (only used in release pipeline)
ARG USE_SCCACHE
ARG SCCACHE_DOWNLOAD_URL
ARG SCCACHE_ENDPOINT
ARG SCCACHE_BUCKET_NAME=vllm-build-sccache
ARG SCCACHE_REGION_NAME=us-west-2
ARG SCCACHE_S3_NO_CREDENTIALS=0

FROM ${BASE_IMAGE} AS base

ARG PYTORCH_ROCM_ARCH
ENV PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}"
ARG AITER_ROCM_ARCH
ENV AITER_ROCM_ARCH="${AITER_ROCM_ARCH}"

ARG SITE_PACKAGES
ENV SITE_PACKAGES=${SITE_PACKAGES}
ENV SDK_DEV="$SITE_PACKAGES/_rocm_sdk_devel" \
    SDK_CORE="$SITE_PACKAGES/_rocm_sdk_core"
ENV ROCM_PATH="$SDK_DEV" \
    ROCM_HOME="$SDK_DEV" \
    HIP_PATH="$SDK_DEV" \
    HIP_CLANG_PATH="$SDK_DEV/lib/llvm/bin" \
    HIP_DEVICE_LIB_PATH="$SDK_CORE/lib/llvm/amdgcn/bitcode"
ENV LD_LIBRARY_PATH="$SDK_DEV/lib:$SDK_DEV/lib/rocm_sysdeps/lib:$SDK_CORE/lib:$SDK_CORE/lib/rocm_sysdeps/lib"
ENV PATH="$SDK_DEV/bin:$SDK_DEV/lib/llvm/bin:$SDK_CORE/bin:$PATH"

# Required for RCCL in ROCm7.1
ENV HSA_NO_SCRATCH_RECLAIM=1

ARG PYTHON_VERSION
ENV PYTHON_VERSION=${PYTHON_VERSION}

# Reproducible layers: pip writes checked-hash .pyc files when
# SOURCE_DATE_EPOCH is set, its download cache lives in a cache mount instead
# of the layer, and apt/ldconfig state with timestamps is removed in the RUN
# that creates it.
ARG SOURCE_DATE_EPOCH
ENV PIP_CACHE_DIR=/root/.cache/pip \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN mkdir -p /app
WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and other dependencies
ARG PIP_VERSION
RUN apt-get update -y \
    && apt-get install -y software-properties-common build-essential git curl sudo vim less libgfortran5 libopenmpi-dev libpci-dev liblzma-dev pkg-config libdrm-dev libnuma-dev kmod \
       libjpeg-dev libsox-dev libsox-fmt-all sox \
    && for i in 1 2 3; do \
        add-apt-repository -y ppa:deadsnakes/ppa && break || \
        { echo "Attempt $i failed, retrying in 5s..."; sleep 5; }; \
    done \
    && apt-get update -y \
    && apt-get install -y python${PYTHON_VERSION} python${PYTHON_VERSION}-dev python${PYTHON_VERSION}-venv \
       python${PYTHON_VERSION}-lib2to3 python-is-python3 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives --set python3 /usr/bin/python${PYTHON_VERSION} \
    && ln -sf /usr/bin/python${PYTHON_VERSION}-config /usr/bin/python3-config \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python${PYTHON_VERSION} - --no-cache-dir "pip==${PIP_VERSION}" \
    && python3 --version && python3 -m pip --version \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin /var/cache/debconf/*-old /var/log/* \
        /var/cache/ldconfig/aux-cache /root/.cache /root/.launchpadlib /var/lib/dbus/machine-id \
    && : > /etc/machine-id

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -U packaging 'cmake<4' ninja wheel 'setuptools<80' pybind11==3.0.4 Cython

# Install ROCm SDK via TheRock
ARG ROCM_RELEASE_WHEELS_MULTIARCH_URL
ARG ROCM_NIGHTLY_WHEELS_MULTIARCH_URL
ARG ROCM_SDK_VERSION
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --index-url ${ROCM_RELEASE_WHEELS_MULTIARCH_URL} \
    --extra-index-url ${ROCM_NIGHTLY_WHEELS_MULTIARCH_URL} \
    "rocm[libraries,devel]${ROCM_SDK_VERSION:+==${ROCM_SDK_VERSION}}" \
    && rocm-sdk init

# Install PyTorch wheels (nightly for latest torch, release as fallback)
ARG TORCH_VERSION
ARG TORCHAUDIO_VERSION
ARG TORCHVISION_VERSION
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    --index-url ${ROCM_RELEASE_WHEELS_MULTIARCH_URL} \
    --extra-index-url ${ROCM_NIGHTLY_WHEELS_MULTIARCH_URL} \
    "torch==${TORCH_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}" \
    "torchvision==${TORCHVISION_VERSION}"

# Install the AMD-compiled device kernels corresponding to PYTORCH_ROCM_ARCH:

# Possible values that can be in PYTORCH_ROCM_ARCH:
#
# gfx90a (MI210/250), gfx942 (MI300), gfx950 (MI350), gfx1100 (7900XTX),
# gfx1101 (7800XT), gfx1200 (9070XT), gfx1201 (9070), gfx1150/1151 (Strix APU)

# One layer per arch, so each is pulled and unpacked in parallel and an arch
# set change only touches its own layer. Arches outside PYTORCH_ROCM_ARCH
# leave an empty layer.
SHELL ["/bin/bash", "-c"]
COPY --chmod=755 <<'EOF' /usr/local/bin/install-rocm-device
#!/bin/bash
set -euo pipefail
arch="$1"
case ";${PYTORCH_ROCM_ARCH};" in
    *";${arch};"*) ;;
    *) exit 0 ;;
esac
pip install --index-url "${ROCM_RELEASE_WHEELS_MULTIARCH_URL}" \
    --extra-index-url "${ROCM_NIGHTLY_WHEELS_MULTIARCH_URL}" \
    "torch[device-${arch}]==${TORCH_VERSION}" \
    "torchvision[device-${arch}]==${TORCHVISION_VERSION}" \
    "rocm[device-${arch}]==${ROCM_SDK_VERSION}"
EOF
# Remove gfx90a xnack kpacks (ASAN artifacts that cause hipErrorInvalidImage on MI250)
RUN --mount=type=cache,target=/root/.cache/pip install-rocm-device gfx90a \
    && rm -f "${SITE_PACKAGES}/torch/.kpack/torch_gfx90a:xnack+.kpack" \
         "${SITE_PACKAGES}/torch/.kpack/torch_gfx90a:xnack-.kpack"
RUN --mount=type=cache,target=/root/.cache/pip install-rocm-device gfx942
RUN --mount=type=cache,target=/root/.cache/pip install-rocm-device gfx950
RUN --mount=type=cache,target=/root/.cache/pip install-rocm-device gfx1100
RUN --mount=type=cache,target=/root/.cache/pip install-rocm-device gfx1101
RUN --mount=type=cache,target=/root/.cache/pip install-rocm-device gfx1200
RUN --mount=type=cache,target=/root/.cache/pip install-rocm-device gfx1201
RUN --mount=type=cache,target=/root/.cache/pip install-rocm-device gfx1150
RUN --mount=type=cache,target=/root/.cache/pip install-rocm-device gfx1151

RUN --mount=type=cache,target=/root/.cache/pip \
    cd $SITE_PACKAGES/_rocm_sdk_core/share/amd_smi && pip install .
ENV PYTHONPATH=$SITE_PACKAGES/_rocm_sdk_core/share/amd_smi

# TheRock runtime fixes
RUN if [ -f "${SITE_PACKAGES}/rocm_sdk/__init__.py" ]; then \
        sed -i 's/rtld_global: bool = True/rtld_global: bool = False/g' "${SITE_PACKAGES}/rocm_sdk/__init__.py"; \
    fi \
    && if [ -f "${SITE_PACKAGES}/_rocm_sdk_core/lib/librocm_smi64.so.1" ] \
       && [ ! -e "${ROCM_PATH}/lib/librocm_smi64.so.7" ]; then \
        ln -sfn "${SITE_PACKAGES}/_rocm_sdk_core/lib/librocm_smi64.so.1" "${ROCM_PATH}/lib/librocm_smi64.so.7"; \
    fi \
    && printf '%s\n%s\n' "${ROCM_PATH}/lib" "${SITE_PACKAGES}/_rocm_sdk_core/lib" > /etc/ld.so.conf.d/rocm-pip.conf \
    && for f in ${SITE_PACKAGES}/_rocm_sdk_core/lib/libamdhip64.so*; do \
        bn=$(basename "$f"); \
        if [ -f "${ROCM_PATH}/lib/${bn}" ] && [ -f "$f" ] && [ ! -L "$f" ]; then \
            rm -f "$f"; \
            ln -sfn "${ROCM_PATH}/lib/${bn}" "$f"; \
        fi; \
    done \
    && for f in librocprofiler-sdk.so.1 librocprofiler-register.so.0 \
              librocprofiler-sdk-roctx.so.1; do \
        if [ -e "${SITE_PACKAGES}/_rocm_sdk_core/lib/${f}" ] \
           && [ -e "${SITE_PACKAGES}/_rocm_sdk_devel/lib/${f}" ]; then \
            rm -f "${SITE_PACKAGES}/_rocm_sdk_core/lib/${f}"; \
            ln -sfn "${SITE_PACKAGES}/_rocm_sdk_devel/lib/${f}" \
                "${SITE_PACKAGES}/_rocm_sdk_core/lib/${f}"; \
        fi; \
    done \
    && ldconfig && rm -f /var/cache/ldconfig/aux-cache

# Install sccache if USE_SCCACHE is enabled (for release builds)
ARG USE_SCCACHE
ARG SCCACHE_DOWNLOAD_URL
ARG SCCACHE_ENDPOINT
ARG SCCACHE_BUCKET_NAME
ARG SCCACHE_REGION_NAME
ARG SCCACHE_S3_NO_CREDENTIALS
RUN if [ "$USE_SCCACHE" = "1" ]; then \
        echo "Installing sccache..." \
        && SCCACHE_ARCH="x86_64" \
        && SCCACHE_VERSION="v0.8.1" \
        && SCCACHE_DL_URL="${SCCACHE_DOWNLOAD_URL:-https://github.com/mozilla/sccache/releases/download/${SCCACHE_VERSION}/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl.tar.gz}" \
        && curl -L -o /tmp/sccache.tar.gz ${SCCACHE_DL_URL} \
        && tar -xzf /tmp/sccache.tar.gz -C /tmp \
        && mv /tmp/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl/sccache /usr/bin/sccache \
        && chmod +x /usr/bin/sccache \
        && rm -rf /tmp/sccache.tar.gz /tmp/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl \
        && sccache --version; \
    fi

# Setup sccache for HIP compilation via HIP_CLANG_PATH
# This creates wrapper scripts in a separate directory and points HIP to use them
# This avoids modifying the original ROCm binaries which can break detection
# NOTE: HIP_CLANG_PATH is NOT set as ENV to avoid affecting downstream images (Dockerfile.rocm)
# Instead, each build stage should export HIP_CLANG_PATH=/opt/sccache-wrappers if USE_SCCACHE=1
RUN if [ "$USE_SCCACHE" = "1" ]; then \
        echo "Setting up sccache wrappers for HIP compilation..." \
        && mkdir -p /opt/sccache-wrappers \
        && printf '#!/bin/bash\nexec sccache %s/lib/llvm/bin/clang++ "$@"\n' "${ROCM_PATH}" > /opt/sccache-wrappers/clang++ \
        && chmod +x /opt/sccache-wrappers/clang++ \
        && printf '#!/bin/bash\nexec sccache %s/lib/llvm/bin/clang "$@"\n' "${ROCM_PATH}" > /opt/sccache-wrappers/clang \
        && chmod +x /opt/sccache-wrappers/clang \
        && echo "sccache wrappers created in /opt/sccache-wrappers"; \
    fi

ENV SCCACHE_BUCKET=${USE_SCCACHE:+${SCCACHE_BUCKET_NAME}}
ENV SCCACHE_REGION=${USE_SCCACHE:+${SCCACHE_REGION_NAME}}
ENV SCCACHE_S3_NO_CREDENTIALS=${USE_SCCACHE:+${SCCACHE_S3_NO_CREDENTIALS}}
ENV SCCACHE_IDLE_TIMEOUT=${USE_SCCACHE:+0}


###
### MORI Build
###
FROM base AS build_mori
ARG MORI_BRANCH
ARG MORI_REPO
RUN git clone ${MORI_REPO}
RUN cd mori \
    && git checkout ${MORI_BRANCH} \
    && git submodule update --init --recursive \
    && ln -sfn ${ROCM_PATH} /opt/rocm \
    && pip install "setuptools_scm>=6.2" \
    && CMAKE_PREFIX_PATH="${ROCM_PATH}:${ROCM_PATH}/lib/rocm_sysdeps" \
       python3 setup.py bdist_wheel --dist-dir=dist && ls /app/mori/dist/*.whl
RUN mkdir -p /app/install && cp /app/mori/dist/*.whl /app/install

###
### FlashAttention Build
###
FROM base AS build_fa
ARG FA_BRANCH
ARG FA_REPO
ARG USE_SCCACHE
RUN git clone ${FA_REPO}
RUN cd flash-attention \
    && git checkout ${FA_BRANCH} \
    && git submodule update --init \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export HIP_CLANG_PATH=/opt/sccache-wrappers \
           && sccache --show-stats; \
       fi \
    && GPU_ARCHS=$(echo ${PYTORCH_ROCM_ARCH} | sed -e 's/;gfx1[0-9]\{3\}//g') python3 setup.py bdist_wheel --dist-dir=dist \
    && if [ "$USE_SCCACHE" = "1" ]; then sccache --show-stats; fi
RUN mkdir -p /app/install && cp /app/flash-attention/dist/*.whl /app/install


###
### AITER Build
###
FROM base AS build_aiter
ARG AITER_BRANCH
ARG AITER_REPO
ARG USE_SCCACHE
RUN git clone --recursive --branch ${AITER_BRANCH} ${AITER_REPO}
RUN cd aiter \
    && git submodule update --init --recursive \
    && pip install -r requirements.txt
# AITER_USE_SYSTEM_TRITON keeps setup.py from resolving its own triton, which would
# displace the pinned one already installed in base.
RUN pip install pyyaml && cd aiter \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export HIP_CLANG_PATH=/opt/sccache-wrappers \
           && sccache --show-stats; \
       fi \
    && PREBUILD_KERNELS=1 AITER_USE_SYSTEM_TRITON=1 GPU_ARCHS=${AITER_ROCM_ARCH} python3 setup.py bdist_wheel --dist-dir=dist \
    && if [ "$USE_SCCACHE" = "1" ]; then sccache --show-stats; fi \
    && ls /app/aiter/dist/*.whl
RUN mkdir -p /app/install && cp /app/aiter/dist/*.whl /app/install


###
### Triton Build
###
FROM base AS build_triton
ARG TRITON_BRANCH
ARG TRITON_REPO
RUN git clone ${TRITON_REPO}
RUN cd triton \
    && git checkout ${TRITON_BRANCH} \
    && if [ ! -f setup.py ]; then cd python; fi \
    && python3 setup.py bdist_wheel --dist-dir=dist \
    && mkdir -p /app/install && cp dist/*.whl /app/install


###
### ROCr + CLR build
###
# Brings in multi-stream perf improvements; drop after these arrive in an official release
FROM base AS build_rocm_runtime
ARG ROCM_SYSTEMS_REPO
ARG ROCM_RUNTIME_COMMIT
# libgl-dev: rocclr does find_package(OpenGL REQUIRED) unconditionally and the wheel image has
# no GL headers. The link must not pick up a libGL DT_NEEDED, which is asserted after the build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ libdw-dev xxd libgl-dev libglx-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir CppHeaderParser
RUN git init -q /src && cd /src \
    && git remote add origin ${ROCM_SYSTEMS_REPO} \
    && git config core.sparseCheckout true \
    && git config remote.origin.promisor true \
    && git config remote.origin.partialclonefilter blob:none \
    && git sparse-checkout init --cone \
    && git sparse-checkout set projects/rocr-runtime projects/clr projects/hip shared cmake \
    && git fetch --filter=blob:none --depth 1 origin ${ROCM_RUNTIME_COMMIT} \
    && git checkout -q FETCH_HEAD
# libelf is taken from the SDK's own vendored sysdeps rather than apt -- the wheel image has no
# /usr/include/libelf.h -- so ROCr links against the copy the wheel itself was built against.
ENV SYSDEPS="$SDK_DEV/lib/rocm_sysdeps"
# ROCr first, and installed into $SDK_DEV, because the clr build below needs its headers.
RUN cd /src/projects/rocr-runtime \
    && cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="$SDK_DEV;$SYSDEPS" \
        -DCMAKE_INSTALL_PREFIX="$SDK_DEV" \
        -DLIBELF_INCLUDE_DIRS="$SYSDEPS/include" \
        -DLIBELF_LIBRARIES="$SYSDEPS/lib/libelf.so" \
    && cmake --build build --parallel 16 \
    && cmake --install build \
    && cmake --install build --prefix /rocr-install --strip
RUN cd /src/projects/clr \
    && cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCLR_BUILD_HIP=ON \
        -DCLR_BUILD_OCL=OFF \
        -DROCM_KPACK_ENABLED=ON \
        -DHIP_COMMON_DIR=/src/projects/hip \
        -DROCM_PATH="$SDK_DEV" \
        -DCMAKE_PREFIX_PATH="$SDK_DEV;$SYSDEPS" \
        -DCMAKE_INSTALL_PREFIX="$SDK_DEV" \
        -DHIP_LLVM_ROOT="$SDK_DEV/lib/llvm" \
    && cmake --build build --parallel 16 \
    && cmake --install build --prefix /clr-install --strip
RUN mkdir -p /staging/lib \
    && cp -P /rocr-install/lib/libhsa-runtime64.so* /staging/lib/ \
    && cp -P /clr-install/lib/libamdhip64.so* /staging/lib/ \
    && ls -l /staging/lib


###
### Build environment for the remaining source dependencies
###
FROM base AS build_env
RUN apt-get update -q -y && apt-get install -q -y libnuma-dev ccache mold \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin /var/log/* /var/cache/ldconfig/aux-cache
ARG UV_VERSION
RUN --mount=type=cache,target=/root/.cache/pip pip install "uv==${UV_VERSION}"
ENV UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY="unsafe-best-match" \
    UV_LINK_MODE=copy \
    CCACHE_DIR=/root/.cache/ccache \
    CCACHE_COMPILERCHECK=content
# Empty by default so build steps fall back to $(nproc).
ARG max_jobs
ENV MAX_JOBS=${max_jobs}

FROM build_env AS build_nixl
ARG NIXL_BRANCH="231d56753047c989062a5cb2ac703a1ad761c7d2"
ARG NIXL_REPO="https://github.com/ai-dynamo/nixl.git"
ARG UCX_BRANCH="96e58a16039f6d7d213bc967b8069238742c5194"
ARG UCX_REPO="https://github.com/openucx/ucx.git"
ENV UCX_HOME=/usr/local/ucx
ENV NIXL_HOME=/usr/local/nixl

# NIXL build system dependencies and RDMA support
RUN apt-get -y update && apt-get -y install autoconf libtool pkg-config \
    libgrpc-dev \
    libgrpc++-dev \
    libprotobuf-dev \
    protobuf-compiler-grpc \
    libcpprest-dev \
    libaio-dev \
    librdmacm1 \
    librdmacm-dev \
    libibverbs1 \
    libibverbs-dev \
    ibverbs-utils \
    rdmacm-utils \
    ibverbs-providers \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system meson meson-python pyyaml types-PyYAML \
        auditwheel build patchelf pytest tomlkit "setuptools>=80.9.0"

RUN --mount=type=cache,target=/root/.cache/ccache \
    cd /usr/local/src && \
    git clone ${UCX_REPO} &&  \
    cd ucx  && \
    git checkout ${UCX_BRANCH} && \
    ./autogen.sh && \
    mkdir build && cd build && \
    CC="ccache gcc" CXX="ccache g++" \
    ../configure \
        --prefix=/usr/local/ucx \
        --enable-shared \
        --disable-static \
        --disable-doxygen-doc \
        --enable-optimizations \
        --enable-devel-headers \
        --with-rocm=${ROCM_PATH} \
        --with-verbs \
        --with-dm \
        --enable-mt && \
    make -j$(nproc) && \
    make install

ENV PATH=/usr/local/ucx/bin:$PATH
ENV LD_LIBRARY_PATH=${UCX_HOME}/lib:${LD_LIBRARY_PATH}

RUN --mount=type=cache,target=/root/.cache/ccache \
    git clone ${NIXL_REPO} /opt/nixl && \
    cd /opt/nixl && \
    git checkout ${NIXL_BRANCH} && \
    CC="ccache gcc" CXX="ccache g++" \
    meson setup build --prefix=${NIXL_HOME} \
                     -Ducx_path=${UCX_HOME} \
                     -Dwheel_variant=rocm \
                     -Dbuild_tests=false \
                     -Dbuild_examples=false && \
    cd build && \
    ninja -j$(nproc) && \
    ninja install && \
    echo "${NIXL_HOME}/lib/$(uname -m)-linux-gnu" \
        > /etc/ld.so.conf.d/nixl.conf && \
    echo "${NIXL_HOME}/lib/$(uname -m)-linux-gnu/plugins" \
        >> /etc/ld.so.conf.d/nixl.conf && \
    ldconfig

# Generate the ROCm NIXL wheel. Upstream's generic wheel helper detects CUDA,
# so configure the ROCm wheel variant directly through Meson.
# Exclude libcore and libpull from auditwheel: transitive dependencies
# that are not shipped in the wheel and vary across base images.
RUN cd /opt/nixl && \
    ./contrib/tomlutil.py --wheel-name nixl-rocm pyproject.toml && \
    CC="ccache gcc" CXX="ccache g++" \
    uv build --wheel --no-build-isolation --out-dir /tmp/nixl_wheels \
        --python ${PYTHON_VERSION} \
        -Csetup-args=-Ducx_path=${UCX_HOME} \
        -Csetup-args=-Dwheel_variant=rocm \
        -Csetup-args=-Dbuild_tests=false \
        -Csetup-args=-Dbuild_examples=false && \
    mkdir -p /tmp/nixl_wheels/repaired /app/install && \
    auditwheel repair \
        --exclude 'libamdhip64*' \
        --exclude 'libcore*' \
        --exclude 'libpull*' \
        /tmp/nixl_wheels/nixl_rocm*.whl \
        --plat manylinux_2_34_$(uname -m) \
        --wheel-dir /tmp/nixl_wheels/repaired && \
    ./contrib/wheel_add_ucx_plugins.py \
        --ucx-plugins-dir ${UCX_HOME}/lib/ucx \
        --nixl-plugins-dir ${NIXL_HOME}/lib/$(uname -m)-linux-gnu/plugins \
        /tmp/nixl_wheels/repaired/*.whl && \
    cp /tmp/nixl_wheels/repaired/*.whl /app/install

# Fetch and verify pinned LMCache source.
FROM build_env AS lmcache_source
ARG LMCACHE_REPO="https://github.com/LMCache/LMCache.git"
ARG LMCACHE_REF="140819c9d57a975dbc5678a6459a218e544cb58b"
ARG LMCACHE_VERSION="0.5.3"

# Remove NVIDIA-only dependencies and accept the release image's NumPy version.
RUN printf '%s\n' "${LMCACHE_REF}" | grep -Eq '^[0-9a-f]{40}$' \
    && git clone --depth=1 --branch "v${LMCACHE_VERSION}" \
        "${LMCACHE_REPO}" /app/lmcache \
    && test "$(git -C /app/lmcache rev-parse HEAD)" = "${LMCACHE_REF}" \
    && test "$(grep -Ec '^(cufile-python|nvtx)([<=>[:space:]]|$)' \
        /app/lmcache/requirements/common.txt)" -eq 2 \
    && test "$(grep -Fxc 'numpy<=2.2.6' \
        /app/lmcache/requirements/common.txt)" -eq 1 \
    && sed -i -E \
        -e '/^(cufile-python|nvtx)([<=>[:space:]]|$)/d' \
        -e 's/^numpy<=2\.2\.6$/numpy<=2.3.5/' \
        /app/lmcache/requirements/common.txt \
    && rm -rf /app/lmcache/.git

FROM build_env AS build_lmcache
COPY --from=lmcache_source \
    /app/lmcache/requirements/build.txt /tmp/lmcache-build-requirements.txt
RUN --mount=type=cache,id=vllm-rocm-uv,target=/root/.cache/uv \
    uv pip install --system -r /tmp/lmcache-build-requirements.txt

ARG LMCACHE_VERSION="0.5.3"
ARG LMCACHE_ROCM_ARCH="gfx942;gfx950"
ARG USE_SCCACHE

COPY --from=lmcache_source /app/lmcache /app/lmcache
WORKDIR /app/lmcache

RUN --mount=type=cache,id=vllm-rocm-ccache,target=/root/.cache/ccache \
    set -eu; \
    printf '%s\n' "${LMCACHE_ROCM_ARCH}" \
        | grep -Eq '^gfx[0-9a-z]+(;gfx[0-9a-z]+)*$'; \
    offload_flags="$(printf '%s' "${LMCACHE_ROCM_ARCH}" \
        | sed 's/;/ --offload-arch=/g; s/^/--offload-arch=/')"; \
    if [ "${USE_SCCACHE:-0}" = "1" ]; then \
        export HIP_CLANG_PATH=/opt/sccache-wrappers; \
    fi; \
    mkdir -p /app/install; \
    SETUPTOOLS_SCM_PRETEND_VERSION="${LMCACHE_VERSION}" \
    PYTORCH_ROCM_ARCH="${LMCACHE_ROCM_ARCH}" \
    HIPCC_COMPILE_FLAGS_APPEND="${offload_flags}" \
    BUILD_WITH_HIP=1 CXX=hipcc \
        python3 setup.py bdist_wheel --dist-dir=/app/install; \
    test "$(find /app/install -maxdepth 1 -name '*.whl' | wc -l)" -eq 1

RUN --mount=type=tmpfs,target=/tmp/lmcache-wheel \
    set -eu; \
    python3 -m zipfile -e /app/install/*.whl /tmp/lmcache-wheel; \
    c_ops="$(find /tmp/lmcache-wheel -type f -name 'c_ops*.so')"; \
    test "$(find /tmp/lmcache-wheel -type f -name 'c_ops*.so' | wc -l)" -eq 1; \
    expected="$(printf '%s' "${LMCACHE_ROCM_ARCH}" | tr ';' '\n' | sort -u)"; \
    actual="$(llvm-objdump --offloading "${c_ops}" \
        | grep -oE 'gfx[0-9a-z]+' | sort -u)"; \
    if [ "${actual}" != "${expected}" ]; then \
        printf 'LMCache code objects mismatch\nexpected:\n%s\nactual:\n%s\n' \
            "${expected}" "${actual}" >&2; \
        exit 1; \
    fi

# DeepEP build stage. ROCShmem is provided by TheRock SDK
# ROCSHMEM_DIR set to the SDK install path so DeepEP finds the headers, etc.
FROM build_env AS build_deepep
ENV ROCSHMEM_DIR=${ROCM_PATH}
ARG DEEPEP_BRANCH="0f63d3e9"
ARG DEEPEP_REPO="https://github.com/ROCm/DeepEP.git"
ARG DEEPEP_NIC="cx7"

# Build DeepEP wheel. DeepEP looks for rocshmem at ROCSHMEM_DIR.
# DeepEP only supports gfx942 and gfx950, so avoid gfx90a in the default list.
# We pass --rocm-gfx942-fp8-fnuz-max 224 to align the DeepEP dispatch FP8
# quantization bound with vLLM's own clamp
# (vllm/model_executor/layers/quantization/utils/fp8_utils.py): 224 for E4M3FNUZ
RUN --mount=type=cache,target=/root/.cache/ccache \
    export PYTORCH_ROCM_ARCH="gfx942;gfx950" \
 && git clone ${DEEPEP_REPO} \
 && cd DeepEP \
 && git checkout ${DEEPEP_BRANCH} \
 && LDFLAGS="-fuse-ld=mold" MAX_JOBS="${MAX_JOBS:-$(nproc)}" python3 setup.py --variant rocm --rocm-explicit-ctx --nic ${DEEPEP_NIC} --rocm-gfx942-fp8-fnuz-max 224 bdist_wheel --dist-dir=/app/deep_install


FROM build_env AS build_torchcodec
ARG TORCHCODEC_REPO
ARG TORCHCODEC_BRANCH
RUN apt-get update -q -y && apt-get install -q -y --no-install-recommends \
        pkg-config ffmpeg libavcodec-dev libavformat-dev libavutil-dev \
        libswscale-dev libavdevice-dev libavfilter-dev libswresample-dev \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/ccache \
    git clone --depth 1 --branch "${TORCHCODEC_BRANCH}" "${TORCHCODEC_REPO}" /app/torchcodec \
    && cd /app/torchcodec \
    && export pybind11_DIR="$(python3 -c 'import pybind11; print(pybind11.get_cmake_dir())')" \
    && TORCHCODEC_DISABLE_COMPILE_WARNING_AS_ERROR=1 I_CONFIRM_THIS_IS_NOT_A_LICENSE_VIOLATION=1 \
       CMAKE_GENERATOR=Ninja CMAKE_C_COMPILER_LAUNCHER=ccache CMAKE_CXX_COMPILER_LAUNCHER=ccache \
       MAX_JOBS="${MAX_JOBS:-$(nproc)}" \
       pip wheel . --no-build-isolation --no-deps -w /app/install

# fastsafetensors from source so its C++ extension is compiled with USE_ROCM
# and can detect libamdhip64.so at runtime. The version comes from the test
# requirements lock.
FROM build_env AS build_fastsafetensors
COPY requirements/test/rocm.txt /tmp/rocm-test-reqs.txt
RUN FASTSAFETENSORS_REQ="$(grep -E '^fastsafetensors(==| @ )' /tmp/rocm-test-reqs.txt | head -1)" \
    && test -n "${FASTSAFETENSORS_REQ}" \
    && pip wheel --no-cache-dir --no-deps --no-binary fastsafetensors \
        -w /app/install "${FASTSAFETENSORS_REQ}"

# rdma-core newer than Ubuntu's, needed by DeepEP's cx7/io NIC paths.
FROM build_env AS build_rdma_core
ARG DEEPEP_NIC="cx7"
ARG RDMA_CORE_VERSION="v62.0"
RUN mkdir -p /out \
    && if [ "${DEEPEP_NIC}" = "cx7" ] || [ "${DEEPEP_NIC}" = "io" ]; then \
        git clone --branch "${RDMA_CORE_VERSION}" --depth 1 https://github.com/linux-rdma/rdma-core.git /tmp/rdma-core \
        && cd /tmp/rdma-core && mkdir build && cd build \
        && cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DNO_MAN_PAGES=1 .. \
        && ninja && DESTDIR=/out ninja install; \
    fi

###
### Wheelhouse: every source-built dependency as its own small artifact,
### keyed by its own inputs (build-runtime.sh), so a pin bump rebuilds only that
### dependency. CI injects existing artifacts with
### --build-context <stage>=docker-image://..., so the build_* stages above only
### run on a miss, and images install fixed bytes and stay reproducible.
###
FROM scratch AS wheel_triton
COPY --from=build_triton /app/install/ /
FROM scratch AS wheel_fa
COPY --from=build_fa /app/install/ /
FROM scratch AS wheel_aiter
COPY --from=build_aiter /app/install/ /
FROM scratch AS wheel_mori
COPY --from=build_mori /app/install/ /
FROM scratch AS wheel_nixl
COPY --from=build_nixl /app/install/ /
FROM scratch AS wheel_deepep
COPY --from=build_deepep /app/deep_install/ /
FROM scratch AS wheel_torchcodec
COPY --from=build_torchcodec /app/install/ /
FROM scratch AS wheel_lmcache
COPY --from=build_lmcache /app/install/ /
FROM scratch AS wheel_fastsafetensors
COPY --from=build_fastsafetensors /app/install/ /
FROM scratch AS rocm_runtime_libs
COPY --from=build_rocm_runtime /staging/lib/ /
FROM scratch AS rdma_core_tree
COPY --from=build_rdma_core /out/ /

FROM scratch AS wheels
COPY --from=wheel_triton / /wheels/runtime/
COPY --from=wheel_fa / /wheels/runtime/
COPY --from=wheel_aiter / /wheels/runtime/
COPY --from=wheel_mori / /wheels/runtime/
COPY --from=wheel_nixl / /wheels/runtime/
COPY --from=wheel_deepep / /wheels/ci/
COPY --from=wheel_torchcodec / /wheels/ci/
COPY --from=wheel_lmcache / /wheels/ci/
COPY --from=wheel_fastsafetensors / /wheels/ci/
COPY --from=rocm_runtime_libs / /rocm-runtime/lib/
COPY --from=rdma_core_tree / /rdma-core/

# Wheel release stage -
# only includes dependencies used by wheel release pipeline
FROM base AS debs_wheel_release
RUN --mount=type=bind,from=wheels,src=/wheels/runtime,target=/install \
    mkdir /app/debs \
    && cp /install/triton-*.whl /install/flash_attn-*.whl /install/amd_aiter-*.whl /app/debs
# The wheel index also serves a torch repacked to require our triton instead of
# the one TheRock built it with, and amdsmi, which TheRock ships only as sources
# inside rocm-sdk-core.
ARG TORCH_VERSION
ARG ROCM_RELEASE_WHEELS_MULTIARCH_URL
ARG ROCM_NIGHTLY_WHEELS_MULTIARCH_URL
COPY tools/vllm-rocm/therock_wheels.py /tmp/therock_wheels.py
# regex and pybase64 aren't installed here; fall back to the stdlib modules.
RUN sed -i -e 's/import regex as re/import re/' \
        -e 's/import pybase64 as base64/import base64/' /tmp/therock_wheels.py \
    && pip download --no-deps --dest /tmp/torch-dl \
        --index-url ${ROCM_RELEASE_WHEELS_MULTIARCH_URL} \
        --extra-index-url ${ROCM_NIGHTLY_WHEELS_MULTIARCH_URL} \
        "torch==${TORCH_VERSION}" \
    && TRITON_VER=$(basename /app/debs/triton-*.whl | cut -d- -f2) \
    && python3 /tmp/therock_wheels.py repack-torch /tmp/torch-dl/torch-*.whl \
        --triton-version "${TRITON_VER}" --out-dir /app/debs \
    && python3 /tmp/therock_wheels.py patch-amdsmi "${SDK_CORE}/share/amd_smi" \
        --out-dir /tmp/amd_smi \
    && pip wheel --no-deps --wheel-dir /app/debs /tmp/amd_smi \
    && rm -rf /tmp/torch-dl /tmp/amd_smi /tmp/therock_wheels.py \
    && ls -l /app/debs

###
### Runtime: the deployment base. The release image is this plus the vLLM
### wheel; the CI image (runtime-ci) is this plus test dependencies.
###
FROM base AS runtime
ARG TRITON_VERSION

# torch 2.12 implicitly attaches rocprofiler-sdk; its queue interposition hangs at HSA
# teardown, so disable it. TODO: drop once ROCm's stock rocprofiler carries the fix.
ENV ROCPROFILER_QUEUE_INTERPOSITION=0

COPY --from=wheels /rocm-runtime/lib/ ${SDK_DEV}/lib/
# Hard link the patched library onto every stock file name, in both SDK trees, so that the
# SONAME lookup and the hard coded paths all resolve to it. Hard links rather than symlinks
# because ldconfig rewrites SONAME symlinks but cannot re-point an inode. $SDK_CORE keeps its
# own libhsa-runtime64 copy, which is on LD_LIBRARY_PATH and in ld.so.conf; relinking it is
# belt and braces rather than strictly required, but it leaves no stock ROCr in the image.
RUN set -eux; \
    cd "$SDK_DEV/lib"; \
    ours_hsa="$(readlink -f libhsa-runtime64.so.1)"; \
    ours_hip="$(readlink -f libamdhip64.so.7)"; \
    for f in "$SDK_DEV"/lib/libhsa-runtime64.so.1* "$SDK_CORE"/lib/libhsa-runtime64.so.1* \
             "$SDK_DEV"/lib/libamdhip64.so.7* "$SDK_CORE"/lib/libamdhip64.so.7*; do \
        [ -f "$f" ] && [ ! -L "$f" ] || continue; \
        case "${f##*/}" in libhsa*) ours="$ours_hsa";; *) ours="$ours_hip";; esac; \
        [ "$f" -ef "$ours" ] || ln -f "$ours" "$f"; \
    done \
    && ldconfig && rm -f /var/cache/ldconfig/aux-cache

# This is to prevent resolvers from checking METADATA and RECORD and clobbering
# the Triton source build we installed. Constraints files are unable to help
# with this. However, these entries are optional and can be blanked which
# solves the problem.
RUN TORCH_DIST_INFO=$(ls -d ${SITE_PACKAGES}/torch-*.dist-info) \
    && grep -q '^Requires-Dist: triton' "$TORCH_DIST_INFO/METADATA" \
    && sed -i '/^Requires-Dist: triton/d' "$TORCH_DIST_INFO/METADATA" \
    && sed -i "s|^\(${TORCH_DIST_INFO##*/}/METADATA\),.*|\1,,|" "$TORCH_DIST_INFO/RECORD"

RUN --mount=type=bind,from=wheels,src=/wheels/runtime,target=/install \
    pip install --no-cache-dir /install/*.whl \
    && ! pip check 2>&1 | grep -iE '^(torch|triton) ' \
    && test "$(pip show triton | awk '/^Version:/ {print $2}')" = "${TRITON_VERSION}" \
    # Create a constraints file to protect the versions we need, especially
    # triton, requirements will try to reinstall repeatedly.
    && pip list --format=freeze \
        | grep -E '^(torch|triton|torchaudio|torchvision|pybind11)==' > /etc/rocm-constraints.txt \
    && echo "ROCm constraints:" && cat /etc/rocm-constraints.txt \
    && test "$(wc -l < /etc/rocm-constraints.txt)" -eq 5 \
    && grep -q '^pybind11==3\.0\.' /etc/rocm-constraints.txt \
    && python3 -c "import torch; assert torch.version.hip, f'non-ROCm torch: {torch.__version__}'; print(f'torch={torch.__version__}')" \
    && python3 -c "import triton; print(f'triton={triton.__version__}')" \
    && pip list 2>/dev/null | grep -iE '^(torch|triton) '

# MoRI NIC userspace. mori auto-detects the NIC at runtime (MORI_DEVICE_NIC
# overrides); only vendor packages for dlopen are needed here.
ARG NIC_BACKEND
ARG AINIC_VERSION
ARG UBUNTU_CODENAME
RUN /bin/bash -lc 'set -euo pipefail; \
 install_ainic() { \
   apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gnupg apt-transport-https; \
   mkdir -p /etc/apt/keyrings; \
   curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key | gpg --dearmor > /etc/apt/keyrings/amdainic.gpg; \
   echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/amdainic.gpg] https://repo.radeon.com/amdainic/pensando/ubuntu/${AINIC_VERSION} ${UBUNTU_CODENAME} main" \
     > /etc/apt/sources.list.d/amdainic.list; \
   apt-get update && apt-get install -y --no-install-recommends libionic-dev ionic-common; \
 }; \
 # NOTE: requires FW 235.2.86.0 and kernel drivers on the host: \
 #   bnxt-en-dkms=1.10.3.235.2.86.0 bnxt-re-dkms=235.2.86.0 (from packages.broadcom.com PPA) \
 install_bnxt() { \
   install -m 0755 -d /etc/apt/keyrings; \
   curl -fsSL https://packages.broadcom.com/artifactory/api/security/keypair/PackagesKey/public \
     -o /etc/apt/keyrings/broadcom-nic.asc; \
   chmod a+r /etc/apt/keyrings/broadcom-nic.asc; \
   echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/broadcom-nic.asc] https://packages.broadcom.com/artifactory/ethernet-nic-debian-public jammy main" \
     > /etc/apt/sources.list.d/broadcom-nic.list; \
   apt-get update && apt-get install -y --no-install-recommends bnxt-rocelib=235.2.86.0; \
   cp -a /usr/local/lib/x86_64-linux-gnu/libbnxt_re* /usr/local/lib/; \
   ldconfig; \
 }; \
 pip install --quiet --no-cache-dir --ignore-installed blinker; \
 pip install --quiet --no-cache-dir quart msgpack aiohttp pyzmq; \
 case "${NIC_BACKEND}" in \
   none)  ;; \
   all)   install_ainic; install_bnxt ;; \
   ainic) install_ainic ;; \
   bnxt)  install_bnxt ;; \
   *)     echo "ERROR: unknown NIC_BACKEND=${NIC_BACKEND}. Use one of: none, ainic, bnxt, all"; exit 2 ;; \
 esac; \
 rm -rf /var/lib/apt/lists/* /var/log/* /var/cache/apt/*.bin /var/cache/ldconfig/aux-cache'

ARG UV_VERSION
RUN pip install --no-cache-dir "uv==${UV_VERSION}"
ENV UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY="unsafe-best-match" \
    UV_LINK_MODE=copy

# vLLM's runtime Python dependencies, so installing the vLLM wheel on top is
# --no-deps for both CI and release.
COPY requirements/common.txt requirements/rocm.txt /tmp/runtime-requirements/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -c /etc/rocm-constraints.txt -r /tmp/runtime-requirements/rocm.txt \
    && rm -rf /tmp/runtime-requirements

ENV HSA_ENABLE_IPC_MODE_LEGACY=1 \
    UCX_RMA_PPLN_ENABLE=y \
    UCX_ROCM_COPY_SIGPOOL_MAX_ELEMS=inf \
    TOKENIZERS_PARALLELISM=false \
    SAFETENSORS_FAST_GPU=1 \
    HIP_FORCE_DEV_KERNARG=1 \
    PYTORCH_NVML_BASED_CUDA_CHECK=1 \
    KINETO_CONFIG=/app/libkineto.conf

ARG BASE_IMAGE
ARG PYTHON_VERSION
ARG ROCM_SDK_VERSION
ARG TORCH_VERSION
ARG TORCHAUDIO_VERSION
ARG TORCHVISION_VERSION
ARG PYTORCH_ROCM_ARCH
ARG AITER_ROCM_ARCH
ARG TRITON_BRANCH
ARG TRITON_REPO
ARG FA_BRANCH
ARG FA_REPO
ARG AITER_BRANCH
ARG AITER_REPO
ARG MORI_BRANCH
ARG MORI_REPO
ARG ROCM_SYSTEMS_REPO
ARG ROCM_RUNTIME_COMMIT
ARG TRITON_VERSION
# Workaround for ROCm profiler limits, and record hashes for Triton and
# pybind11 so we can verify later.
RUN echo "ROCTRACER_MAX_EVENTS=10000000" > /app/libkineto.conf \
    && echo "BASE_IMAGE: ${BASE_IMAGE}" > /app/versions.txt \
    && echo "PYTHON_VERSION: ${PYTHON_VERSION}" >> /app/versions.txt \
    && echo "ROCM_SDK_VERSION: ${ROCM_SDK_VERSION}" >> /app/versions.txt \
    && echo "TORCH_VERSION: ${TORCH_VERSION}" >> /app/versions.txt \
    && echo "TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION}" >> /app/versions.txt \
    && echo "TORCHVISION_VERSION: ${TORCHVISION_VERSION}" >> /app/versions.txt \
    && echo "PYTORCH_ROCM_ARCH: ${PYTORCH_ROCM_ARCH}" >> /app/versions.txt \
    && echo "AITER_ROCM_ARCH: ${AITER_ROCM_ARCH}" >> /app/versions.txt \
    && echo "TRITON_BRANCH: ${TRITON_BRANCH}" >> /app/versions.txt \
    && echo "TRITON_REPO: ${TRITON_REPO}" >> /app/versions.txt \
    && echo "FA_BRANCH: ${FA_BRANCH}" >> /app/versions.txt \
    && echo "FA_REPO: ${FA_REPO}" >> /app/versions.txt \
    && echo "AITER_BRANCH: ${AITER_BRANCH}" >> /app/versions.txt \
    && echo "AITER_REPO: ${AITER_REPO}" >> /app/versions.txt \
    && echo "MORI_BRANCH: ${MORI_BRANCH}" >> /app/versions.txt \
    && echo "MORI_REPO: ${MORI_REPO}" >> /app/versions.txt \
    && echo "ROCM_SYSTEMS_REPO: ${ROCM_SYSTEMS_REPO}" >> /app/versions.txt \
    && echo "ROCM_RUNTIME_COMMIT: ${ROCM_RUNTIME_COMMIT}" >> /app/versions.txt \
    && echo "MORI_NIC_BACKEND: ${NIC_BACKEND}" >> /app/versions.txt \
    && echo "AINIC_VERSION: ${AINIC_VERSION}" >> /app/versions.txt \
    # Fingerprint our triton so Dockerfile.rocm can prove it survived the build.
    && echo "TRITON_VERSION: $(pip show triton | awk '/^Version:/ {print $2}')" >> /app/versions.txt \
    && echo "TRITON_SHA256: $(find $(python3 -c 'import triton, os; print(os.path.dirname(triton.__file__))') \
        -type f \( -name '*.py' -o -name '*.so' \) | sort | xargs sha256sum | sha256sum | cut -d' ' -f1)" \
        >> /app/versions.txt \
    && echo "PYBIND11_VERSION: $(pip show pybind11 | awk '/^Version:/ {print $2}')" >> /app/versions.txt \
    && echo "PYBIND11_INTERNALS_VERSION: $(grep -rhE '^#[[:space:]]*define PYBIND11_INTERNALS_VERSION' \
        $(python3 -c 'import pybind11; print(pybind11.get_include())') | awk '{print $NF}')" \
        >> /app/versions.txt \
    && echo "PYBIND11_SHA256: $(find $(python3 -c 'import pybind11; print(pybind11.get_include())') \
        -type f -name '*.h' | sort | xargs sha256sum | sha256sum | cut -d' ' -f1)" \
        >> /app/versions.txt

###
### CI runtime: runtime plus what the test suite needs, ordered so the most
### frequently changing inputs (test requirements) are the top layers.
###
FROM runtime AS runtime-ci

# uv writes a timestamped uv_cache.json (listed in RECORD) for local-path
# installs and leaves lock files in /tmp; drop both so rebuilds are
# byte-identical.
COPY --chmod=755 <<'EOF' /usr/local/bin/uv-reproducible-cleanup
#!/bin/bash
set -euo pipefail
find "${SITE_PACKAGES}" -path '*.dist-info/uv_cache.json' -delete
sed -i '/\.dist-info\/uv_cache\.json,/d' "${SITE_PACKAGES}"/*.dist-info/RECORD
rm -rf /tmp/uv-*
EOF

ENV CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    PATH=/root/.cargo/bin:${PATH}
COPY rust-toolchain.toml /tmp/rust-toolchain.toml
RUN TOOLCHAIN="$(grep '^channel' /tmp/rust-toolchain.toml | sed 's/.*= *"\(.*\)"/\1/')" \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --default-toolchain none \
    && rustup toolchain install "${TOOLCHAIN}" \
    && rustup default "${TOOLCHAIN}" \
    && rm -rf /tmp/rust-toolchain.toml /root/.rustup/tmp/* /root/.rustup/downloads/* \
    && for f in /root/.rustup/toolchains/*/lib/rustlib/components; do sort -o "$f" "$f"; done \
    && rustc --version && cargo --version

# rdma-core (DeepEP NIC support) plus RDMA userspace and FFmpeg libs for torchcodec.
COPY --from=wheels /rdma-core/ /
RUN timeout --kill-after=30s 5m apt-get update -q -y --error-on=any \
    -o Acquire::Retries=3 \
    -o Acquire::http::Timeout=30 \
    -o Acquire::https::Timeout=30 \
    && apt-get install -q -y --no-install-recommends \
    -o Acquire::Retries=3 \
    -o Acquire::http::Timeout=30 \
    -o Acquire::https::Timeout=30 \
    librdmacm1 \
    libibverbs1 \
    ibverbs-providers \
    ibverbs-utils \
    util-linux \
    unzip \
    libsodium23 \
    pkg-config ffmpeg libavcodec-dev libavformat-dev libavutil-dev \
    libswscale-dev libavdevice-dev libavfilter-dev libswresample-dev \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin /var/log/* /var/cache/ldconfig/aux-cache \
        /var/cache/fontconfig/* \
    && find /usr/share/fonts /usr/local/share/fonts -name .uuid -delete

# DeepEP and torchcodec (ROCm/torch ABI) from the wheelhouse.
RUN --mount=type=bind,from=wheels,src=/wheels/ci,target=/install \
    --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -c /etc/rocm-constraints.txt /install/deep_ep-*.whl /install/torchcodec-*.whl \
    && uv-reproducible-cleanup

# Enable fast and less brittle model downloads in tests.
ENV HF_XET_HIGH_PERFORMANCE=1 \
    HF_HUB_DOWNLOAD_TIMEOUT=60 \
    MIOPEN_DEBUG_CONV_DIRECT=0 \
    MIOPEN_DEBUG_CONV_GEMM=0

# vLLM test dependencies.
COPY requirements/test/rocm.txt /tmp/rocm-test-reqs.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -c /etc/rocm-constraints.txt -r /tmp/rocm-test-reqs.txt \
    && uv-reproducible-cleanup

# The ROCm build of fastsafetensors replaces the PyPI one.
RUN --mount=type=bind,from=wheels,src=/wheels/ci,target=/install \
    python3 -m pip install --no-cache-dir --force-reinstall --no-deps /install/fastsafetensors-*.whl \
    && rm /tmp/rocm-test-reqs.txt

COPY tests/vllm_test_utils /tmp/vllm_test_utils
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system /tmp/vllm_test_utils \
    && rm -rf /tmp/vllm_test_utils \
    && uv-reproducible-cleanup

RUN --mount=type=bind,from=wheels,src=/wheels/ci,target=/install \
    --mount=type=bind,source=requirements/test/rocm.txt,target=/tmp/lmcache-constraints.txt \
    --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --constraint /tmp/lmcache-constraints.txt /install/lmcache-*.whl \
    && uv-reproducible-cleanup \
    && PYTHONDONTWRITEBYTECODE=1 python3 -c "import lmcache, lmcache.c_ops; print('lmcache', lmcache.__version__)"

###
### Release base: runtime plus the LMCache wheel, which Dockerfile.rocm's
### INSTALL_LMCACHE=true installs. Must stay the last stage: the release
### pipeline builds this file without --target.
###
FROM runtime AS final
COPY --from=wheel_lmcache / /opt/vllm-rocm/wheels/
